{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenAI": {
    "ApiKey": "API_KEY",
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/",
    "MaxTokens": 500,
    "Temperature": 0.2, // creativity
    "TopP": 1.0 // nucleus rating creativity measure, default = 1.0
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Authentication": {
    "Mode": "Ldap"
  },
  "Ldap": {
    "Host": "",
    "Port": 389,
    "UseSsl": false,
    "IgnoreCertificateErrors": false,
    "SearchBase": "",
    "UserFilter": "(uid={0})",
    "UserDnPattern": "",
    "BindDn": "",
    "BindPassword": ""
  },
  "MockAuthentication": {
    "Users": [
      {
        "Username": "developer",
        "Password": "developer",
        "DisplayName": "Local Developer",
        "Email": "developer@example.org"
      }
    ]
  },
  "AllowedHosts": "*"
}
