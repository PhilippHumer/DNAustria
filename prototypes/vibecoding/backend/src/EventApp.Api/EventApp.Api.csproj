<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\\EventApp.Core\\EventApp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude legacy/corrupted Controllers folder from compilation until cleaned -->
    <Compile Remove="Controllers\**\*.cs" />
    <!-- Include new, clean controllers placed under ApiControllers -->
    <Compile Include="ApiControllers\**\*.cs" />
  </ItemGroup>
</Project>