<backend>
    <organisations>
        <api>
            <endpoint name="Alle Organisationen" method="GET" path="/api/organizations" />
            <endpoint name="Einzelne Organisation" method="GET" path="/api/organizations/{id}" />
            <endpoint name="Organisation nach Name suchen" method="GET" path="/api/organizations?name={name}" />
            <endpoint name="Organisation erstellen" method="POST" path="/api/organizations" />
            <endpoint name="Organisation aktualisieren" method="PUT" path="/api/organizations/{id}" />
            <endpoint name="Organisation löschen" method="DELETE" path="/api/organizations/{id}" />
        </api>
        <datafeld max="50" name="name"/>
        <datafeld max="50" name="adresse"/>
        
        <delete>SoftDelete</delete>
        
    </organisations>

    <contacts>
        <api>
            <endpoint name="Alle Kontakte" method="GET" path="/api/contacts" />
            <endpoint name="Einzelner Kontakt" method="GET" path="/api/contacts/{id}" />
            <endpoint name="Kontakt nach Name suchen" method="GET" path="/api/contacts?name={name}" />
            <endpoint name="Kontakt erstellen" method="POST" path="/api/contacts" />
            <endpoint name="Kontakt aktualisieren" method="PUT" path="/api/contacts/{id}" />
            <endpoint name="Kontakt löschen" method="DELETE" path="/api/contacts/{id}" />
        </api>
    </contacts>

    <events>
        <api>
            <endpoint name="Alle Events" method="GET" path="/api/events" />
            <endpoint name="Einzelnes Event" method="GET" path="/api/events/{id}" />
            <endpoint name="Event nach Name suchen" method="GET" path="/api/events?name={name}" />
            <endpoint name="Event erstellen" method="POST" path="/api/events" />
            <endpoint name="Event aktualisieren" method="PUT" path="/api/events/{id}" />
            <endpoint name="Event löschen" method="DELETE" path="/api/events/{id}" />
            <endpoint name="Eventstatus aktualisieren" method="PATCH" path="/api/events/{id}/status" />
            <endpoint name="Öffentliche Events abrufen" method="GET" path="/api/public/events" />
            <endpoint name="LLM Generierung anstoßen" method="POST" path="/api/events/llm" />
        </api>
    </events>

    <locations>
        <api>
            <endpoint name="Alle Locations" method="GET" path="/api/locations" />
            <endpoint name="Einzelne Location" method="GET" path="/api/locations/{id}" />
            <endpoint name="Location erstellen" method="POST" path="/api/locations" />
            <endpoint name="Location aktualisieren" method="PUT" path="/api/locations/{id}" />
            <endpoint name="Location löschen" method="DELETE" path="/api/locations/{id}" />
        </api>
    </locations>

    <responseConventions>
        <rule>
      Bei PUT, PATCH und POST: Rückgabe des aktualisierten/erstellten Objekts
      mit Statuscode 200 (OK) oder 201 (Created).
        </rule>
    </responseConventions>

    








</backend>